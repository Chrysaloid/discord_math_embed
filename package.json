{
  "name": "discord_math_embed",
  "version": "1.0.0",
  "description": "Cloudflare Worker: a math expression in the URL, its result in the Discord embed",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "npm run typecheck",
    "deploy": "wrangler deploy",
    "build": "esbuild src/creator.ts --bundle --minify --sourcemap --target=es2022 --outfile=dist/creator.js --log-level=warning",
    "typecheck": "wrangler types && tsc && tsc -p tsconfig.creator.json"
  },
  "dependencies": {
    "mathjs": "^15.2.0"
  }
}
